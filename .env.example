# Azure OpenAI Configuration
VITE_AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
VITE_AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
VITE_AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# Azure Table Storage Configuration for Chat Persistence
# Replace with your SAS URL (including Table Service SAS token)
VITE_AZURE_STORAGE_SAS_URL=https://your-storage-account-name.table.core.windows.net/?sv=...

# Clerk Authentication Configuration
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
